STRUDEL_HOST=127.0.0.1
STRUDEL_PORT=8787
STRUDEL_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000","https://strudel.cc"]

STRUDEL_SAMPLES_ROOT=../../samples
STRUDEL_CHUNK_DURATION_SECONDS=2.5
STRUDEL_SAMPLE_RATE=16000
STRUDEL_CHANNELS=1
STRUDEL_MAX_CHUNKS_PER_SESSION=8
STRUDEL_SESSION_POLL_INTERVAL_SECONDS=0.05

STRUDEL_RECORDER_BACKEND=microphone
# Optional: set microphone device index only when needed.
# STRUDEL_MICROPHONE_DEVICE=0

STRUDEL_TRANSCRIBER_BACKEND=faster-whisper
STRUDEL_FASTER_WHISPER_MODEL=base
STRUDEL_FASTER_WHISPER_DEVICE=auto
STRUDEL_FASTER_WHISPER_COMPUTE_TYPE=int8
STRUDEL_FASTER_WHISPER_BEAM_SIZE=1

STRUDEL_VAD_BACKEND=silero
STRUDEL_ENABLE_VAD=true
STRUDEL_MIN_WORD_DURATION_SECONDS=0.04
STRUDEL_PHRASE_GROUP_SIZE=2

# --- Calibration: stop words being clipped at their boundaries -------------
# Symmetric margin (s) added to every word/phrase/sentence slice. 0.04 keeps
# leading/trailing consonants; raise toward 0.06 if cuts still sound tight.
STRUDEL_SLICE_PADDING_SECONDS=0.04

# --- Noise robustness (needs: pip install -r requirements.realtime.txt) ----
# 1) Spectral-gating denoise before ASR (fans, hum, steady background).
STRUDEL_ENABLE_DENOISE=true
STRUDEL_DENOISE_BACKEND=noisereduce
STRUDEL_DENOISE_PROP_DECREASE=0.8
STRUDEL_DENOISE_STATIONARY=false
# 2) Drop whole near-silent chunks so the recognizer never transcribes ambient
#    noise (a common hallucination source). ~0.005 is a good starting floor.
STRUDEL_ENABLE_ENERGY_GATE=true
STRUDEL_MIN_CHUNK_RMS=0.005
# 3) Drop low-confidence words (typically noise mis-recognised as speech).
STRUDEL_WORD_MIN_PROBABILITY=0.45

STRUDEL_ENABLE_REFINEMENT=false
STRUDEL_REFINEMENT_BACKEND=mock

STRUDEL_STRUDEL_BASE_URL=http://127.0.0.1:8787
